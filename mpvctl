#!/bin/sh

PLAYLIST_FILE="$HOME"/.local/share/mpvd_playlist.m3u
MPVD_PID="$(pgrep -f "input-ipc-server=$XDG_RUNTIME_DIR/mpvd")"
MPVD_LOG="/tmp/mpvd.log"

usage() {
    cat << EOFUSAGE
$PROGNAME <cmd> [ARGS...]

COMMANDS:
  p | play		- start playing
  s | pause		- pause current file
  T | toggle		- toggle current file
  N | next		- play next file
  P | prev		- play previous file
  l | ls		- list the playlist
  c | clear		- clear the playlist
  S | shuffle		- shuffle the playlist
  j | jump [i]		- jump to index in playlist
  e | seek [i]		- seek in seconds
  t | time [i]		- jump to time in seconds
  O | prop [...]	- get property
  C | cmd [...]		- send custom command
  a | add [...]		- add parameters to playlist
  d | del [i] [i]	- delete item or range
  save [file]		- save current playlist to file
  load [file]		- load playlit from file
  start			- start mpv server
  stop			- stop mpv server
  restart		- restart mpv server
  status		- print mpv server status
  log			- list the mpv server log
  h | help		- print usage

PIPE:
  find ~/music/ -type f | $PROGNAME

EOFUSAGE
}

log() {
    cat "$MPVD_LOG"
}

err() {
    printf "Error: %s\n" "$@"
    exit 1
}

start() {
    test -e "$PLAYLIST_FILE" || touch "$PLAYLIST_FILE"

    if [ -z "$MPVD_PID" ]; then
        setsid -f mpv \
            --loop-playlist \
            --cache=yes \
            --cache-secs=60 \
            --demuxer-max-bytes=256MiB \
            --demuxer-readahead-secs=30 \
            --no-video \
            --idle=yes \
            --playlist="$PLAYLIST_FILE" \
            --input-ipc-server="$XDG_RUNTIME_DIR"/mpvd > "$MPVD_LOG" 2>&1
    fi
}

stop() {
    if [ -n "$MPVD_PID" ]; then
        kill -9 "$MPVD_PID"
    fi
}

restart() {
    stop
    MPVD_PID=""
    start
}

status() {
    if [ -n "$MPVD_PID" ]; then
        echo "mpv server is running ($MPVD_PID)"
        exit 0
    else
        echo 'mpv server is down'
        exit 1
    fi
}

recheck_mpvd() {
    if [ -z "$MPVD_PID" ]; then
        echo 'mpv server is down'
        start
        echo 'starting mpv server ...'
        while [ -z "$MPVD_PID" ]; do
            sleep 0.1
            MPVD_PID="$(pgrep -f "input-ipc-server=$XDG_RUNTIME_DIR/mpvd")"
        done
    fi
}

cmd() {
    cmd="$1"
    args=""
    idx=0
    shift
    for a in "$@"; do
        [ $((idx = idx + 1)) -le "$#" ] && args="$args, "
        case "${a}" in
            true | false | [0-9]*) args="${args}${a}" ;;
            *) args="${args}\"${a}\"" ;;
        esac
    done
    printf '{ "command": ["%s"%s] }\n' "$cmd" "$args" | $UNIX_SOCK_CMD
}

append() {
    opt="$1"
    [ -n "$opt" ] && shift
    if [ -t 0 ]; then
        for f in "$@"; do
            fullpath="$(realpath "$f")"
            cmd "loadfile" "$fullpath" "$opt" > /dev/null
            echo "$fullpath" >> "$PLAYLIST_FILE"
        done
    else
        while read -r f; do
            fullpath="$(realpath "$f")"
            cmd "loadfile" "$fullpath" "$opt" > /dev/null
            echo "$fullpath" >> "$PLAYLIST_FILE"
        done
    fi
}

delete() {
    if [ -n "$2" ]; then
        runs=$(($2 - $1))
        for _ in $(seq "0" "$runs"); do
            cmd "playlist-remove" "$1" > /dev/null
        done
    else
        cmd "playlist-remove" "$1" > /dev/null
    fi

    cmd "get_property" "playlist" | "${JQ_CMD}" -r .data[].filename > "$PLAYLIST_FILE"
}

shuffle() {
    cmd "playlist-shuffle" > /dev/null
    cmd "get_property" "playlist" | "${JQ_CMD}" -r .data[].filename > "$PLAYLIST_FILE"
}

save() {
    cmd "get_property" "playlist" | "${JQ_CMD}" -r .data[].filename > "$1"
}

load() {
    cat "$1" > "$PLAYLIST_FILE"
}

list() {
    bold=$(tput bold)
    normal=$(tput sgr0)

    # one socket round-trip for everything, one jq pass for all formatting
    # shellcheck disable=SC2016 # jq vars ($r, $s, ...), not shell expansions
    {
        printf '{ "request_id": 1, "command": ["get_property", "playlist"] }\n'
        printf '{ "request_id": 2, "command": ["get_property", "pause"] }\n'
        printf '{ "request_id": 3, "command": ["get_property", "playback-time"] }\n'
        printf '{ "request_id": 4, "command": ["get_property", "duration"] }\n'
    } | $UNIX_SOCK_CMD | "${JQ_CMD}" -r -s --arg bold "$bold" --arg normal "$normal" '
        reduce .[] as $r ({};
            if   $r.request_id == 1 then .playlist = $r.data
            elif $r.request_id == 2 then .paused   = $r.data
            elif $r.request_id == 3 then .playback = $r.data
            elif $r.request_id == 4 then .duration = $r.data
            else . end
        ) as $s
        | "Playlist:",
          ($s.playlist | to_entries[] |
             ((.value.filename | split("/") | last | sub("\\.[^.]*$"; "")) as $name
              | if .value.current
                then "\($bold)[\(.key)] \($name) [*]\($normal)"
                else "[\(.key)] \($name)"
                end)),
          (($s.playback // 0 | floor) as $pb
           | ($s.duration // 0 | floor) as $du
           | "\nstatus: " +
             (if $s.paused or (($s.playlist | length) == 0)
              then "paused"
              else "playing"
              end) +
             ", time: " +
             "\($pb/3600|floor):\(($pb%3600)/60|floor):\($pb%60)/" +
             "\($du/3600|floor):\(($du%3600)/60|floor):\($du%60), file: " +
             (if (($s.playlist | length) > 0)
              then (($s.playlist | map(select(.current)) | .[0].filename) // "")
                   | split("/") | last | sub("\\.[^.]*$"; "")
              else ""
              end))'
}

toggle() {
    paused="$(cmd "get_property" "pause" | "${JQ_CMD}" -r .data)"
    if [ "$paused" = "true" ]; then
        cmd "set_property" "pause" "false"
    else
        cmd "set_property" "pause" "true"
    fi
}

: "${PROGNAME:="$0"}"
: "${UNIX_SOCK_PATH:="$XDG_RUNTIME_DIR/mpvd"}"

: "${JQ_CMD:=$(command -v jq)}"
[ -z "$JQ_CMD" ] && err "could not find jq"

if [ -z "$UNIX_SOCK_CMD" ]; then
    if [ "$(command -v socat)" ]; then
        UNIX_SOCK_CMD="socat - ${UNIX_SOCK_PATH}"
    else
        err "could not find socat"
    fi
fi

# check if command args are empty
cmd="$1"
[ -z "$cmd" ] && list && exit 0
[ -n "$cmd" ] && shift

# recheck_mpvd commands
case "$cmd" in
    O | prop | C | cmd | p | play | s | pause | T | toggle | c | clear | \
        N | next | P | prev | j | jump | t | time | e | seek | a | add | \
        d | del | delete | S | shuffle | l | ls | save | load | log)
        recheck_mpvd
        ;;
esac

# main control flow for args
case "$cmd" in
    O | prop) cmd "get_property" "$@" ;;
    C | cmd) cmd "$@" ;;
    p | play) cmd "set_property" "pause" "false" ;;
    s | pause) cmd "set_property" "pause" "true" ;;
    T | toggle) toggle ;;
    c | clear) cmd "stop" && truncate -s 0 "$PLAYLIST_FILE" ;;
    N | next) cmd "playlist-next" ;;
    P | prev) cmd "playlist-prev" ;;
    j | jump) cmd "set_property" "playlist-pos" "$1" ;;
    t | time) cmd "set_property" "time-pos" "$1" ;;
    e | seek) cmd "add" "time-pos" "$1" ;;
    a | add) append "append-play" "$@" ;;
    d | del | delete) delete "$@" ;;
    S | shuffle) shuffle ;;
    l | ls) list ;;
    save) save "$@" ;;
    load) load "$@" ;;
    start) start ;;
    stop) stop ;;
    restart) restart ;;
    status) status ;;
    log) log ;;
    *) usage && exit 1 ;;
esac

exit 0
